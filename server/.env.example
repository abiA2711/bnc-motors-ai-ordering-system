# Copy this file to server/.env and replace the placeholders.
# Do not commit server/.env.

# API port. Defaults to 5000 when omitted.
PORT=5000

# Browser origin allowed by CORS. The Vite dev server uses this origin.
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string used by the pg pool.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bnc_motors

# Secret used to sign login tokens. Use a long random value of your own.
JWT_SECRET=replace-with-a-long-random-string

# Purchase-order text parser: mock or gemini.
# mock does not call Google. gemini requires the two variables below.
PO_EXTRACTION_PROVIDER=mock

# Required only when PO_EXTRACTION_PROVIDER=gemini.
# The server does not choose a model when GEMINI_MODEL is empty.
GEMINI_API_KEY=
GEMINI_MODEL=
